# ─── Frontend Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local for local development.
# For production (Vercel), set these in the Vercel dashboard under
# Project Settings → Environment Variables.

# ─── Public URLs (exposed to browser bundle) ─────────────────────────────────
# The full URL of this Next.js frontend
NEXT_PUBLIC_APP_URL=http://localhost:5180

# The FastAPI backend REST API base URL
NEXT_PUBLIC_API_URL=http://localhost:8030

# The FastAPI backend WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8030

# ─── Better Auth (server-only) ───────────────────────────────────────────────
# PostgreSQL connection string — same DB as the backend
DATABASE_URL=postgresql://latexy_user:password@localhost:5432/latexy

# Must match NEXT_PUBLIC_APP_URL exactly (used by Better Auth for CSRF/CORS)
BETTER_AUTH_URL=http://localhost:5180

# Strong random secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-in-development

# ─── OAuth Providers (optional) ──────────────────────────────────────────────
# Leave blank to disable Google/GitHub sign-in (server-side).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Controls whether the OAuth buttons render on the sign-in/sign-up forms.
# Set to 'true' ONLY when the matching provider above is configured. Any other
# value (incl. blank) hides the button so no dead buttons are shown.
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=
NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=

# ─── Transactional Email (optional in dev, REQUIRED in production) ───────────
# Used for password-reset and email-verification messages (Better Auth).
# If RESEND_API_KEY is unset, the action link is logged to the server console
# and NOT sent — local auth flows still work. That fallback is development-only:
# with NODE_ENV=production a missing key throws instead (see src/lib/email.ts).
RESEND_API_KEY=
# From-address for outbound email. Must be a domain verified in Resend.
EMAIL_FROM=Latexy <no-reply@latexy.app>

# ─── Proxy ───────────────────────────────────────────────────────────────────
# Set to 'true' ONLY when a reverse proxy you control (the bundled nginx) is the
# sole ingress. The auth rate limiter then buckets on X-Real-IP / the last
# X-Forwarded-For hop; otherwise it ignores those headers, because a caller that
# can forge them can mint a fresh password-reset budget per request.
TRUST_PROXY_HEADERS=false

# ─── Misc ────────────────────────────────────────────────────────────────────
# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
