FROM node:22-alpine

WORKDIR /app

# Install pnpm 9 (matches lockfileVersion: 9.0)
RUN npm install -g pnpm@9

# Install dependencies first (cached layer). Built with the frontend as context,
# so pnpm resolves frontend/package.json standalone (no workspace here). No
# committed frontend lockfile — the single source of truth is the repo-root
# pnpm-lock.yaml; a second one would drift on every Dependabot bump.
COPY package.json ./
RUN pnpm install --no-frozen-lockfile

# Source code is mounted as a volume — no COPY needed for dev
ARG PORT=5180
ENV PORT=${PORT}
EXPOSE ${PORT}

CMD ["sh", "-c", "pnpm dev"]
