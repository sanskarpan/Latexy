# Build from the repository root so development uses CI's lock, overrides and patches.
FROM node:22-alpine AS dependencies
WORKDIR /workspace
RUN npm install -g pnpm@10.10.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY frontend/package.json ./frontend/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts
# Portable links remain valid after Compose mounts frontend source over /app.
RUN pnpm --filter ./frontend deploy --legacy /dev-runtime

FROM node:22-alpine
WORKDIR /app
RUN npm install -g pnpm@10.10.0
COPY --from=dependencies /dev-runtime/node_modules ./node_modules
ARG PORT=5180
ENV PORT=${PORT}
EXPOSE ${PORT}

CMD ["sh", "-c", "pnpm dev"]
