# Production-optimized Dockerfile for Latexy Frontend
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy lockfile and manifests first for layer caching
COPY package.json pnpm-lock.yaml ./

# Install all deps (including devDependencies needed for next build)
RUN pnpm install --no-frozen-lockfile

# Copy source code
COPY . .

# Build the application.
# NEXT_PUBLIC_* are inlined into the browser bundle at build time, so they must
# be the values the *browser* will use.
#   NEXT_PUBLIC_API_URL  — same-origin path prefix; nginx proxies /api/ to the backend.
#   NEXT_PUBLIC_WS_URL   — must be an ABSOLUTE ws(s):// origin with no path:
#                          the client appends /ws/jobs (api-client.ts getWebSocketUrl)
#                          and feeds the result to `new URL()`, which rejects
#                          relative values. There is no sane default for a public
#                          origin, so the build fails loudly when it is missing.
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_WS_URL
ARG BUILD_VERSION=local
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_TELEMETRY_DISABLED=1

RUN case "$NEXT_PUBLIC_WS_URL" in \
      ws://*|wss://*) ;; \
      *) echo "ERROR: NEXT_PUBLIC_WS_URL build-arg must be an absolute ws:// or wss:// origin (e.g. wss://latexy.com), got '$NEXT_PUBLIC_WS_URL'" >&2; exit 1 ;; \
    esac

RUN pnpm run build

# Production stage
FROM node:22-alpine AS production

# PORT is read by the Next standalone server (server.js). 5180 is what the nginx
# `frontend` upstream and the k8s Service target, so it is the image default.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=5180 \
    HOSTNAME=0.0.0.0

RUN apk add --no-cache dumb-init

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

WORKDIR /app

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider "http://localhost:${PORT}/" || exit 1

EXPOSE 5180

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]
