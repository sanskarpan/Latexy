# Production-optimized Dockerfile for Latexy Frontend
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.10.0 --activate

# The build context is the repository root. Install from the workspace root so
# pnpm uses the committed lockfile and preserves workspace/patch resolution.
COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY frontend/package.json ./frontend/package.json
COPY packages/browser-extension/package.json ./packages/browser-extension/package.json
COPY packages/tui/package.json ./packages/tui/package.json

# Install all deps (including devDependencies needed for next build) exactly as
# resolved by the repository lockfile.
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .
WORKDIR /app/frontend

# Build the application.
# NEXT_PUBLIC_* are inlined into the browser bundle at build time, so they must
# be the values the *browser* will use.
#   NEXT_PUBLIC_API_URL  — same-origin path prefix; nginx proxies /api/ to the backend.
#   NEXT_PUBLIC_WS_URL   — must be an ABSOLUTE ws(s):// origin with no path:
#                          the client appends /ws/jobs (api-client.ts getWebSocketUrl)
#                          and feeds the result to `new URL()`, which rejects
#                          relative values. There is no sane default for a public
#                          origin, so the build fails loudly when it is missing.
ARG NEXT_PUBLIC_APP_URL=https://latexy.xyz
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_WS_URL
ARG BETTER_AUTH_URL=https://latexy.xyz
ARG BUILD_VERSION=local
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    BETTER_AUTH_URL=$BETTER_AUTH_URL \
    NEXT_TELEMETRY_DISABLED=1

RUN case "$NEXT_PUBLIC_WS_URL" in \
      ws://*|wss://*) ;; \
      *) echo "ERROR: NEXT_PUBLIC_WS_URL build-arg must be an absolute ws:// or wss:// origin (e.g. wss://latexy.xyz), got '$NEXT_PUBLIC_WS_URL'" >&2; exit 1 ;; \
    esac

RUN pnpm run build

# Production stage
FROM node:22-alpine AS production

ARG BUILD_VERSION=local

# PORT is read by the Next standalone server (server.js). 5180 is what the nginx
# `frontend` upstream and the k8s Service target, so it is the image default.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=5180 \
    HOSTNAME=0.0.0.0 \
    BUILD_VERSION=$BUILD_VERSION

RUN apk add --no-cache dumb-init

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

WORKDIR /app

COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/static ./frontend/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/frontend/public ./frontend/public

USER nextjs

HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider "http://localhost:${PORT}/" || exit 1

EXPOSE 5180

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "frontend/server.js"]
