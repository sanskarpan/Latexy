# Disposable CI fixture only. MinIO Community is source-only; do not fall back
# to removed/private registry images or an unofficial precompiled binary.
# Official supported build command and immutable source resolution:
# https://github.com/minio/minio/releases/tag/RELEASE.2025-10-15T17-29-55Z
# https://proxy.golang.org/github.com/minio/minio/@v/v0.0.0-20251015172955-9e49d5e7a648.info
# The official public Go builder's manifest digest was verified anonymously.
FROM golang:1.24.8-bookworm@sha256:4ed690d6649d63c312b99a6120025ec79ce3b542968a37da53d6236c7c61a848 AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOPROXY=https://proxy.golang.org GOSUMDB=sum.golang.org GOBIN=/out
RUN go install -trimpath -p 2 github.com/minio/minio@v0.0.0-20251015172955-9e49d5e7a648 \
    && go version -m /out/minio

# No shell, registry tooling, operator files, or application credentials.
FROM scratch
COPY --from=build /out/minio /minio
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a"
ENV HOME=/tmp MINIO_UPDATE=off
USER 65532:65532
EXPOSE 9000
ENTRYPOINT ["/minio"]
