+/**
+ * True when a branch contains a top-level `*` or `?` wildcard. A repeated
+ * `+(...)`/`*(...)` that repeats a wildcard-bearing branch can backtrack
+ * catastrophically on a non-match (e.g. `+(*a)` against `aaaa...b`).
+ * Escaped characters, brackets and nested groups are not top level. A branch
+ * that is only a single wildcard is safe and handled by the caller.
+ */
+const hasTopLevelWildcard = branch => {
+  if (branch === '*' || branch === '?') {
+    return false;
+  }
+
+  let escaped = false;
+  let bracket = 0;
+  let paren = 0;
+
+  for (let i = 0; i < branch.length; i++) {
+    const ch = branch[i];
+
+    if (escaped === true) {
+      escaped = false;
+      continue;
+    }
+
+    if (ch === '\\') {
+      escaped = true;
+      continue;
+    }
+
+    if (ch === '[') {
+      bracket++;
+      continue;
+    }
+
+    if (ch === ']' && bracket > 0) {
+      bracket--;
+      continue;
+    }
+
+    if (ch === '(') {
+      paren++;
+      continue;
+    }
+
+    if (ch === ')' && paren > 0) {
+      paren--;
+      continue;
+    }
+
+    if (bracket > 0 || paren > 0) {
+      continue;
+    }
+
+    if (ch === '*' || ch === '?') {
+      return true;
+    }
+  }
+
+  return false;
+};
