# @inkjs/ui declares react as a peer dependency. pnpm's isolated layout does not
# link peers into a dependency's own node_modules, and react is not hoisted by
# default, so Node's ESM resolver walking up from
#   node_modules/.pnpm/@inkjs+ui@.../node_modules/@inkjs/ui/build/...
# never finds it — react lives in packages/tui/node_modules, which is not on that
# path. The TUI suite then fails with "Cannot find package 'react'".
#
# Hoisting react/react-dom into node_modules/.pnpm/node_modules puts them on the
# walk-up path, which is where Node looks next.
hoist-pattern[]=*
hoist-pattern[]=react
hoist-pattern[]=react-dom
