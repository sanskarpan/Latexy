{
  "manifest_version": 3,
  "name": "Latexy Job Companion",
  "version": "0.1.0",
  "description": "Capture a job posting for Latexy and fill common application identity fields on demand.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://latexy.xyz/*",
    "http://localhost:5180/*",
    "http://127.0.0.1:5180/*"
  ],
  "action": {
    "default_title": "Latexy Job Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://latexy.xyz/*",
        "http://localhost:5180/*",
        "http://127.0.0.1:5180/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
