# Production-optimized Dockerfile for Latexy Backend
FROM python:3.12-slim AS builder

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create and activate virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install the generated, hash-verified production lock.
COPY requirements.lock .
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

# Production stage
FROM python:3.12-slim AS production

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app"

# Install system dependencies and LaTeX
RUN apt-get update && apt-get install -y \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-fonts-extra \
    texlive-xetex \
    texlive-luatex \
    texlive-lang-chinese \
    texlive-lang-japanese \
    texlive-lang-korean \
    texlive-lang-arabic \
    texlive-lang-european \
    texlive-lang-greek \
    texlive-lang-english \
    fonts-noto-cjk \
    fonts-noto-core \
    fonts-texgyre \
    fonts-lohit-deva \
    tesseract-ocr \
    tesseract-ocr-eng \
    poppler-utils \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy virtual environment from builder stage
COPY scripts/warm_tex_cache.sh /usr/local/bin/latexy-warm-tex-cache
RUN sh /usr/local/bin/latexy-warm-tex-cache
COPY scripts/build_trusted_render_formats.py /opt/latexy-format-build/scripts/build_trusted_render_formats.py
COPY app/services/render_engine/managed_preamble.py /opt/latexy-format-build/app/services/render_engine/managed_preamble.py
RUN python /opt/latexy-format-build/scripts/build_trusted_render_formats.py
COPY scripts/write_renderer_fingerprint.py /usr/local/bin/latexy-write-renderer-fingerprint.py
RUN python /usr/local/bin/latexy-write-renderer-fingerprint.py
ENV TEXMFCACHE=/var/lib/texmf

COPY --from=builder /opt/venv /opt/venv

# Create non-root user
RUN groupadd -r latexy && useradd -r -g latexy latexy

# Create app directory and set permissions
WORKDIR /app
RUN mkdir -p /app/temp /app/logs && \
    chown -R latexy:latexy /app && \
    mkdir -p /var/lib/texmf/latexy-cache /var/lib/texmf/latexy-config && \
    chown latexy:latexy /var/lib/texmf/latexy-cache /var/lib/texmf/latexy-config

# Copy application code
COPY --chown=latexy:latexy . /app/

# Normalize font-directory metadata before the runtime user bakes font caches.
RUN set -eu; \
    engine_fonts="$(kpsewhich -var-value=TEXMFDIST)/fonts"; \
    find "$engine_fonts" /usr/share/fonts /usr/local/share/fonts \
      -type d -exec touch -m -d '@1704067200' {} +; \
    fc-cache --force --system-only

# Switch to non-root user
USER latexy

# Listening port. Single source of truth for the image; matches Settings.PORT
# (app/core/config.py) and every consumer (nginx upstream, compose healthcheck,
# k8s containerPort/probes). Override with -e PORT=... if you must.
ENV PORT=8030 \
    UVICORN_WORKERS=4
# Keep the non-root font cache in the TeX runtime tree recognized by the sandbox.
ENV TEXMFVAR=/var/lib/texmf/latexy-cache \
    TEXMFCONFIG=/var/lib/texmf/latexy-config

# Bake the trusted font cache with runtime ownership, never with queued input.
RUN python scripts/warm_lualatex_cache.py

# Health check (shell form so $PORT is expanded at runtime)
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f "http://localhost:${PORT}/health" || exit 1

# Expose port
EXPOSE 8030

# Run the application
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port \"${PORT}\" --workers \"${UVICORN_WORKERS}\" --ws-max-size 524288"]
