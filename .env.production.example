# Production/self-host Environment Variables for Latexy
# Copy this file to .env.production and replace every placeholder.

# Application Environment
FASTAPI_ENV=production
NODE_ENV=production
DEBUG=false
# Set only when the backend is reachable exclusively through the bundled nginx,
# which overwrites X-Real-IP with $remote_addr. Rate limiters then bucket per real
# client instead of collapsing every user into one shared bucket.
TRUST_PROXY_HEADERS=true

# Released image coordinates consumed by docker-compose.prod.yml. Set
# LATEXY_VERSION to an immutable released tag or SHA image tag (see
# .github/workflows/release.yml). The empty value is intentional: startup must
# fail until an operator chooses the exact image revision to deploy.
LATEXY_IMAGE_PREFIX=ghcr.io/sanskarpan
LATEXY_VERSION=

# Database Configuration. These values start the bundled pgvector/PostgreSQL
# service. To use a managed database, replace DATABASE_URL with its connection
# string; the bundled postgres service may then be disabled with a Compose
# override.
DATABASE_URL=postgresql://latexy_user:your_secure_password@postgres:5432/latexy_prod
POSTGRES_DB=latexy_prod
POSTGRES_USER=latexy_user
POSTGRES_PASSWORD=your_secure_password

# Redis Configuration. The bundled stack wires application containers to the
# private `redis` service. These values are retained for scripts and managed
# service overrides.
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_PASSWORD=your_redis_password
REDIS_MAX_CONNECTIONS=50

# Object storage. The bundled compose stack runs private MinIO; choose strong,
# unique credentials. The backend and worker never expose these to the browser.
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key-at-least-32-chars
MINIO_BUCKET=latexy

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Production Infrastructure
DEPLOY_ENV=production
MONITORING_WEBHOOK_URL=your_monitoring_webhook_url
DEPLOYMENT_WEBHOOK_URL=your_deployment_webhook_url
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Load Balancer Configuration
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_CLIENT_MAX_BODY_SIZE=50M

# Rate Limiting
API_RATE_LIMIT=10r/s
COMPILE_RATE_LIMIT=2r/s

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_INTERVAL=60

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# Job Management Configuration
JOB_RESULT_TTL=86400
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=60

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_HEARTBEAT_INTERVAL=30

# LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_API_KEY=your_gemini_api_key

# API Key Encryption (Generate a secure 32-byte key)
API_KEY_ENCRYPTION_KEY=your_32_byte_encryption_key_base64_encoded

# Authentication Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_key
BETTER_AUTH_URL=https://latexy.xyz
# Backend session/JWT signing key. Settings.model_post_init refuses to start in
# production without it.
JWT_SECRET_KEY=your_jwt_secret_key

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Dodo Payments. The application defaults to sandbox mode; production switches only by setting DODO_MODE=live.
DODO_MODE=live
DODO_TEST_API_KEY=
DODO_TEST_WEBHOOK_KEY=
DODO_TEST_BUSINESS_ID=
DODO_LIVE_API_KEY=your_dodo_live_api_key
DODO_LIVE_WEBHOOK_KEY=your_dodo_live_webhook_signing_key
DODO_LIVE_BUSINESS_ID=your_dodo_live_business_id
DODO_TEST_PRODUCT_BASIC_MONTHLY=
DODO_TEST_PRODUCT_BASIC_ANNUAL=
DODO_TEST_PRODUCT_PRO_MONTHLY=
DODO_TEST_PRODUCT_PRO_ANNUAL=
DODO_TEST_PRODUCT_BYOK_MONTHLY=
DODO_TEST_PRODUCT_BYOK_ANNUAL=
DODO_TEST_PRODUCT_STUDENT=
DODO_TEST_PRODUCT_TEAM=
DODO_TEST_PRODUCT_WEEKLY=
DODO_TEST_PRODUCT_LIFETIME=
DODO_LIVE_PRODUCT_BASIC_MONTHLY=your_live_product_id_basic_monthly
DODO_LIVE_PRODUCT_BASIC_ANNUAL=your_live_product_id_basic_annual
DODO_LIVE_PRODUCT_PRO_MONTHLY=your_live_product_id_pro_monthly
DODO_LIVE_PRODUCT_PRO_ANNUAL=your_live_product_id_pro_annual
DODO_LIVE_PRODUCT_BYOK_MONTHLY=your_live_product_id_byok_monthly
DODO_LIVE_PRODUCT_BYOK_ANNUAL=your_live_product_id_byok_annual
DODO_LIVE_PRODUCT_STUDENT=your_live_product_id_student
DODO_LIVE_PRODUCT_TEAM=your_live_product_id_team
DODO_LIVE_PRODUCT_WEEKLY=your_live_product_id_weekly
DODO_LIVE_PRODUCT_LIFETIME=your_live_product_id_lifetime
WEEKLY_AMOUNT_MINOR=0
LIFETIME_AMOUNT_MINOR=0
BILLING_CURRENCY=INR

# B59 user referrals. Disabled by default; when enabled, rewards are
# subscription-extension days earned only after a server-verified paid event.
# The plan-family list is parsed as JSON by pydantic-settings.
REFERRAL_PROGRAM_ENABLED=false
REFERRAL_REWARD_DAYS=0
REFERRAL_QUALIFYING_PLAN_FAMILIES=["basic","pro","byok","student","team","weekly","lifetime"]
REFERRAL_MAX_ATTRIBUTIONS_PER_REFERRER=1000
REFERRAL_ATTRIBUTION_WINDOW_HOURS=24

# Frontend Configuration. Keep the browser API path same-origin; nginx routes
# it to FastAPI while preserving Next.js-owned /api/auth and /api/byok routes.
NEXT_PUBLIC_APP_URL=https://latexy.xyz
NEXT_PUBLIC_API_URL=/api
# Baked into the browser bundle at build time. Must be the absolute public
# ws(s):// origin — the client appends /ws/jobs and /ws/collab and feeds the
# result to `new URL()`, which rejects relative values.
NEXT_PUBLIC_WS_URL=wss://latexy.xyz
NEXT_TELEMETRY_DISABLED=1

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/latexy.crt
SSL_KEY_PATH=/etc/ssl/latexy.key
# Space-separated names accepted by the bundled nginx virtual host.
NGINX_SERVER_NAME=latexy.example.com

# Monitoring Configuration
GRAFANA_PASSWORD=your_secure_grafana_password
FLOWER_USER=admin
FLOWER_PASSWORD=your_flower_password

# Security Configuration
# JSON array — pydantic-settings parses List[str] fields as JSON, so a
# comma-separated value raises SettingsError at import and crash-loops
# backend, celery-worker, celery-beat and flower.
CORS_ORIGINS=["https://latexy.xyz","https://www.latexy.xyz"]
ALLOWED_HOSTS=latexy.xyz,www.latexy.xyz

# Logging Configuration
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Backup Configuration
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# CDN Configuration (Optional)
CDN_URL=https://cdn.your-domain.com

# Transactional Email (frontend/src/lib/email.ts refuses the console-logging
# fallback in production, so sign-up and password reset throw without a key)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@your-domain.com

# Email Configuration (for notifications)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your_email@your-domain.com
SMTP_PASSWORD=your_email_password
FROM_EMAIL=noreply@your-domain.com
